@startuml user-cjm

title Авито.Кухня — CJM пользователя

skinparam shadowing false
skinparam activity {
    BackgroundColor White
    BorderColor Black
    DiamondBackgroundColor White
    DiamondBorderColor Black
}

start

partition "Пользователь" {
    :Открывает Авито.Кухню;
}

partition "Система" {
    :Показывает список доступных заведений;
}

partition "Пользователь" {
    :Выбирает заведение;
}

partition "Система" {
    :Показывает меню заведения\nи доступность позиций;
}

partition "Пользователь" {
    :Выбирает позиции\nи количество;
    :Отправляет заказ;
}

partition "Система" {
    :Проверяет корректность заказа;

    if (Все выбранные позиции\nсуществуют и доступны?) then (Да)
        :Получает актуальные\nназвания и цены;
        :Рассчитывает итоговую стоимость;
        :Создаёт заказ\nсо статусом CREATED;
        :Сохраняет snapshot\nпозиций заказа;
    else (Нет)
        :Не создаёт заказ\nи сообщает об ошибке;
    endif
}

partition "Пользователь" {
    :Получает информацию\nо созданном заказе;
    :Ожидает решения заведения;
}

partition "Система" {
    if (Заведение приняло заказ?) then (Да)
        :Статус ACCEPTED;
    else (Нет)
        :Статус REJECTED;

        partition "Пользователь" {
            :Видит, что заказ отклонён;
        }

        stop
    endif
}

partition "Пользователь" {
    :Проверяет статус заказа;
}

partition "Система" {
    :PREPARING;
    :READY;
}

partition "Пользователь" {
    :Видит, что заказ готов;
}

partition "Система" {
    :COMPLETED;
}

partition "Пользователь" {
    :Видит завершённый заказ;
}

stop

@enduml